# yaranai-measured の環境変数(キー名だけ・値は空)。
# 実値は .gitignore 済みの .env に置く。個人情報はソースにもこのファイルにも書かない。

# Supabase(実測版は申告版とは別プロジェクト)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 開発者モード判定用。ログイン中の email がこれと一致すると庭デバッグモードになる。
# 未設定なら常に本番挙動。EAS env にも同じキーを登録すること。
EXPO_PUBLIC_DEV_EMAIL=

# Google認証(オンボーディング §2)。Google CloudのOAuthクライアント(Web)のID。
# 未設定なら「Googleではじめる」ボタンごと出ない。EAS env にも登録すること。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 規約URL(/terms /privacy)が未公開の間、1 にすると同意行ごと非表示になる
# (クローズドテスト用。公開後は外すこと)
EXPO_PUBLIC_HIDE_TERMS_CONSENT=
