{
  "expo": {
    "name": "Yaranai",
    "slug": "yaranai-measured",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#F1EBDE",
    "icon": "./assets/icon.png",
    "scheme": "yaranaimeasured",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "app.yaranai.measured",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-google-signin/google-signin",
      "./plugins/with-x-queries",
      "./plugins/with-mailto-queries"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77df197f-a51a-430b-ae45-033d565a4fd7"
      }
    },
    "owner": "ssstaka",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/77df197f-a51a-430b-ae45-033d565a4fd7"
    },
    "ios": {}
  }
}
